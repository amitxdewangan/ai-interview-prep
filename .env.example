# Environment Configuration Template for AI Interview Prep Kit
# Copy this file to .env before starting the server

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000 # Client URL (CORS Whitelist)

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB Connection String
MONGODB_URI=mongodb_atlas_connection_string

# JWT Secret
JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=7d

# LLM Provider: Google Gemini
GEMINI_API_KEY=gemini_api_key_here
GEMINI_MODEL=gemini_model_name

# Fallback LLM Provider: Groq
GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=groq_model_name

# Scraping & Security (SSRF Policy)
# ALLOW_LOCAL_URLS: Set to true during batch evaluation (npm run evaluate) so local test servers
# like http://localhost:8099/acme/ are allowed by the SSRF validator.
ALLOW_LOCAL_URLS=false
